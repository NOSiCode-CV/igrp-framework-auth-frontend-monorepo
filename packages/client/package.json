{
  "name": "@igrp/platform-access-management-client-ts",
  "version": "0.2.0-beta.8",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "release": "pnpm build && yarn publish --non-interactive --registry=https://sonatype.nosi.cv/repository/igrp/ --tag latest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "happy-dom": "^18.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-dts": "4.5.4",
    "vitest": "^3.2.4"
  }
}
